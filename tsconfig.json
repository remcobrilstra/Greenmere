{
  // Type-checks the JavaScript as-is (npm run typecheck); nothing is emitted.
  // Scope grows a folder at a time: add a folder to "include" once it checks clean.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/sim/**/*.js"]
}
